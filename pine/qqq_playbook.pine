//@version=5
indicator("SPX 0DTE Playbook — 2026-07-13", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// Generated by Vantage for the 2026-07-13 session (from 2026-07-12). Dealer gamma: positive.
// Confluence zones (≥2 dimensions stacking: GEX wall / gamma flip / fib / PoC / S-R) are
// baked from Python (Pine can't compute GEX/fib/PoC). The chart shows ONLY those zones + a
// corner table; the regime tint + arrows update live off price vs the gamma flip.
//
// ⚠️ NOT FINANCIAL ADVICE. Arrows are CONDITIONAL context (fade a confluence zone; go with
//    momentum on a flip break), not a guaranteed buy/sell. The GEX read is OI-based and BLIND
//    to 0DTE flow (~half of SPX volume). Context, not a signal (ADR-008). Apply on an SPX chart.

// ── theme (Auto uses the chart background; override with the input) ──
themeIn = input.string("Auto", "Theme", options=["Auto", "Dark", "Light"])
isDark = themeIn == "Dark" ? true : themeIn == "Light" ? false : (chart.bg_color == color.white ? false : true)
coexist = input.bool(false, "Coexist mode (with LuxAlgo etc.)", tooltip="On: suppress our shaded boxes so they don't collide with another indicator's zones — keep the table + letter lines only.")
showZones = input.bool(true, "Confluence zones (boxes)") and not coexist
showLevels = input.bool(true, "Level lines + letter keys")
showGex = input.bool(true, "Dealer-gamma (GEX) levels")
showTable = input.bool(true, "Levels table")
showArrows = input.bool(true, "Buy/Sell/Break arrows")
confirmCloses = input.int(3, "Reclaim confirmation closes", minval=1, maxval=5, tooltip="Consecutive closes back through a level required before an arrow fires — the validated reclaim discipline (3 consecutive 5m closes; set the chart to 5m to match). 1 = legacy single-bar behavior.")
showRegime = input.bool(true, "Regime tint") and not coexist

confirmed = barstate.isconfirmed
flipLevel = 725.0
aboveFlip = close > flipLevel
bgcolor(showRegime and aboveFlip ? color.new(color.green, 96) : showRegime ? color.new(color.red, 96) : na)
lvlBuy1 = 719.6
var bool armedBuy1 = true
var bool tagBuy1 = false
var int nBuy1 = 0
if confirmed
    if low <= lvlBuy1
        tagBuy1 := true
        nBuy1 := close > lvlBuy1 ? 1 : 0
    else
        nBuy1 := tagBuy1 ? nBuy1 + 1 : 0
buyTrig1 = showArrows and confirmed and tagBuy1 and nBuy1 >= confirmCloses
fadeBuy1 = buyTrig1 and armedBuy1
if fadeBuy1
    tagBuy1 := false
    nBuy1 := 0
armedBuy1 := confirmed ? (fadeBuy1 ? false : (low > lvlBuy1 * 1.001 ? true : armedBuy1)) : armedBuy1
plotshape(fadeBuy1, title="bounce support zone", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.small, text="BUY")
alertcondition(fadeBuy1, title="bounce support zone", message="SPX reclaimed bounce support zone — reclaim entry confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="SPX broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showZones
        box.new(bar_index - 40, 720.0, bar_index + 5, 719.3, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 50.0% + put wall  720", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
    if showLevels
        // per-row level lines + letter markers (table keys)
        line.new(bar_index - 40, 730.0, bar_index + 3, 730.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 730.0, "A", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 725.0, bar_index + 3, 725.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 725.0, "B", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 719.6, bar_index + 3, 719.6, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_solid)
        label.new(bar_index + 3, 719.6, "C", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 712.7, bar_index + 3, 712.7, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 712.7, "D", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
    if showGex
        // --- dealer-gamma (GEX) levels: labeled lines w/ price ---
        line.new(bar_index - 40, 730.0, bar_index + 3, 730.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 730.0, "Call wall 730", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 720.0, bar_index + 3, 720.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 720.0, "Put wall 720", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 725.0, bar_index + 3, 725.0, extend=extend.left, color=color.new((isDark ? #FDD835 : #B8860B), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 725.0, "Gamma flip 725", style=label.style_label_left, color=color.new((isDark ? #FDD835 : #B8860B), 15), textcolor=color.white, size=size.small)
    // --- levels table ---
    if showTable
        // theme-aware table colors
        tblBg = isDark ? color.new(#0d1117, 4) : color.new(#f4f6f8, 3)
        tblTx = isDark ? color.new(#e6edf3, 0) : color.new(#1b2733, 0)
        tblHd = isDark ? color.new(#1f6feb, 0) : color.new(#0b4fa8, 0)
        var table pb = table.new(position.top_right, 4, 9, bgcolor=tblBg, border_width=1, border_color=color.new(color.gray, 60), frame_width=1)
        table.clear(pb, 0, 0, 3, 8)
        table.cell(pb, 0, 0, "SPX 0DTE · 2026-07-13 · gamma positive · VIX 15", text_color=tblHd, text_size=size.normal, text_halign=text.align_left)
        table.merge_cells(pb, 0, 0, 3, 0)
        table.cell(pb, 0, 1, "Plan: above the 725 line = moves stay calm, expect a range; buy dips near 719-720; sell rallies near 726", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 1, 3, 1)
        table.cell(pb, 0, 2, "A", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 2, "730", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 2, "call wall", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 2, "price often stalls / turns here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 3, "B", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 3, "725", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 3, "gamma flip", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 3, "trend-change line: above = calmer, below = faster moves", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 4, "C", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 4, "720", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 4, "✦ fib 50.0% + put wall ✦", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 4, "good spot to buy dips", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 5, "D", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 5, "713", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 5, "volume PoC", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 5, "price gets stuck / chops here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 6, "Trend: trending up (rising highs and lows); stuck between 725 and 726 for now", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 6, 3, 6)
        table.cell(pb, 0, 7, "Volume: volume near its median — no clear tell", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 7, 3, 7)
        table.cell(pb, 0, 8, "★ = has held for many days · a guide, not a trade signal · not financial advice", text_color=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 8, 3, 8)
