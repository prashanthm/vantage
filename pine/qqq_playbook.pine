//@version=5
indicator("QQQ 0DTE Playbook — 2026-07-15", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// Generated by Vantage for the 2026-07-15 session (from 2026-07-14). Dealer gamma: negative.
// Confluence zones (≥2 dimensions stacking: GEX wall / gamma flip / fib / PoC / S-R) are
// baked from Python (Pine can't compute GEX/fib/PoC). The chart shows ONLY those zones + a
// corner table; the regime tint + arrows update live off price vs the gamma flip.
//
// ⚠️ NOT FINANCIAL ADVICE. Arrows are CONDITIONAL context (fade a confluence zone; go with
//    momentum on a flip break), not a guaranteed buy/sell. The GEX read is OI-based and BLIND
//    to 0DTE flow. Context, not a signal (ADR-008). Apply on a QQQ chart.

// ── theme (Auto uses the chart background; override with the input) ──
themeIn = input.string("Auto", "Theme", options=["Auto", "Dark", "Light"])
isDark = themeIn == "Dark" ? true : themeIn == "Light" ? false : (chart.bg_color == color.white ? false : true)
coexist = input.bool(false, "Coexist mode (with LuxAlgo etc.)", tooltip="On: suppress our shaded boxes so they don't collide with another indicator's zones — keep the table + letter lines only.")
showZones = input.bool(true, "Confluence zones (boxes)") and not coexist
showLevels = input.bool(true, "Level lines + letter keys")
showGex = input.bool(true, "Dealer-gamma (GEX) levels")
showTable = input.bool(true, "Levels table")
showArrows = input.bool(true, "Buy/Sell/Break arrows")
confirmCloses = input.int(3, "Reclaim confirmation closes", minval=1, maxval=5, tooltip="Consecutive closes back through a level required before an arrow fires — the validated reclaim discipline (3 consecutive 5m closes; set the chart to 5m to match). 1 = legacy single-bar behavior.")
showRegime = input.bool(true, "Regime tint") and not coexist

confirmed = barstate.isconfirmed
flipLevel = 722.0
aboveFlip = close > flipLevel
bgcolor(showRegime and aboveFlip ? color.new(color.green, 96) : showRegime ? color.new(color.red, 96) : na)
lvlSell1 = 721.5
var bool armedSell1 = true
var bool tagSell1 = false
var int nSell1 = 0
if confirmed
    if high >= lvlSell1
        tagSell1 := true
        nSell1 := close < lvlSell1 ? 1 : 0
    else
        nSell1 := tagSell1 ? nSell1 + 1 : 0
sellTrig1 = showArrows and confirmed and tagSell1 and nSell1 >= confirmCloses
fadeSell1 = sellTrig1 and armedSell1
if fadeSell1
    tagSell1 := false
    nSell1 := 0
armedSell1 := confirmed ? (fadeSell1 ? false : (high < lvlSell1 * 0.999 ? true : armedSell1)) : armedSell1
plotshape(fadeSell1, title="fade resistance zone", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.small, text="SELL")
alertcondition(fadeSell1, title="fade resistance zone", message="QQQ lost fade resistance zone — reclaim-short confirmed.")
lvlBuy2 = 719.6
var bool armedBuy2 = true
var bool tagBuy2 = false
var int nBuy2 = 0
if confirmed
    if low <= lvlBuy2
        tagBuy2 := true
        nBuy2 := close > lvlBuy2 ? 1 : 0
    else
        nBuy2 := tagBuy2 ? nBuy2 + 1 : 0
buyTrig2 = showArrows and confirmed and tagBuy2 and nBuy2 >= confirmCloses
fadeBuy2 = buyTrig2 and armedBuy2
if fadeBuy2
    tagBuy2 := false
    nBuy2 := 0
armedBuy2 := confirmed ? (fadeBuy2 ? false : (low > lvlBuy2 * 1.001 ? true : armedBuy2)) : armedBuy2
plotshape(fadeBuy2, title="bounce support zone", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.small, text="BUY")
alertcondition(fadeBuy2, title="bounce support zone", message="QQQ reclaimed bounce support zone — reclaim entry confirmed.")
lvlSell3 = 721.2
var bool armedSell3 = true
var bool tagSell3 = false
var int nSell3 = 0
if confirmed
    if high >= lvlSell3
        tagSell3 := true
        nSell3 := close < lvlSell3 ? 1 : 0
    else
        nSell3 := tagSell3 ? nSell3 + 1 : 0
sellTrig3 = showArrows and confirmed and tagSell3 and nSell3 >= confirmCloses
fadeSell3 = sellTrig3 and armedSell3
if fadeSell3
    tagSell3 := false
    nSell3 := 0
armedSell3 := confirmed ? (fadeSell3 ? false : (high < lvlSell3 * 0.999 ? true : armedSell3)) : armedSell3
plotshape(fadeSell3, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell3, title="durable resistance (4d)", message="QQQ lost durable resistance (4d) — reclaim-short confirmed.")
lvlBuy4 = 715.2
var bool armedBuy4 = true
var bool tagBuy4 = false
var int nBuy4 = 0
if confirmed
    if low <= lvlBuy4
        tagBuy4 := true
        nBuy4 := close > lvlBuy4 ? 1 : 0
    else
        nBuy4 := tagBuy4 ? nBuy4 + 1 : 0
buyTrig4 = showArrows and confirmed and tagBuy4 and nBuy4 >= confirmCloses
fadeBuy4 = buyTrig4 and armedBuy4
if fadeBuy4
    tagBuy4 := false
    nBuy4 := 0
armedBuy4 := confirmed ? (fadeBuy4 ? false : (low > lvlBuy4 * 1.001 ? true : armedBuy4)) : armedBuy4
plotshape(fadeBuy4, title="durable support (4d)", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.normal, text="BUY★")
alertcondition(fadeBuy4, title="durable support (4d)", message="QQQ reclaimed durable support (4d) — reclaim entry confirmed.")
lvlBuy5 = 713.8
var bool armedBuy5 = true
var bool tagBuy5 = false
var int nBuy5 = 0
if confirmed
    if low <= lvlBuy5
        tagBuy5 := true
        nBuy5 := close > lvlBuy5 ? 1 : 0
    else
        nBuy5 := tagBuy5 ? nBuy5 + 1 : 0
buyTrig5 = showArrows and confirmed and tagBuy5 and nBuy5 >= confirmCloses
fadeBuy5 = buyTrig5 and armedBuy5
if fadeBuy5
    tagBuy5 := false
    nBuy5 := 0
armedBuy5 := confirmed ? (fadeBuy5 ? false : (low > lvlBuy5 * 1.001 ? true : armedBuy5)) : armedBuy5
plotshape(fadeBuy5, title="durable support (4d)", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.normal, text="BUY★")
alertcondition(fadeBuy5, title="durable support (4d)", message="QQQ reclaimed durable support (4d) — reclaim entry confirmed.")
lvlSell6 = 724.1
var bool armedSell6 = true
var bool tagSell6 = false
var int nSell6 = 0
if confirmed
    if high >= lvlSell6
        tagSell6 := true
        nSell6 := close < lvlSell6 ? 1 : 0
    else
        nSell6 := tagSell6 ? nSell6 + 1 : 0
sellTrig6 = showArrows and confirmed and tagSell6 and nSell6 >= confirmCloses
fadeSell6 = sellTrig6 and armedSell6
if fadeSell6
    tagSell6 := false
    nSell6 := 0
armedSell6 := confirmed ? (fadeSell6 ? false : (high < lvlSell6 * 0.999 ? true : armedSell6)) : armedSell6
plotshape(fadeSell6, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell6, title="durable resistance (4d)", message="QQQ lost durable resistance (4d) — reclaim-short confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="QQQ broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showZones
        box.new(bar_index - 40, 722.0, bar_index + 5, 721.1, border_color=color.new((isDark ? #EF5350 : #C62828), 55), bgcolor=color.new((isDark ? #EF5350 : #C62828), 88), extend=extend.left, text="support (2x) + gamma flip  722", text_size=size.small, text_color=(isDark ? #EF5350 : #C62828), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 720.0, bar_index + 5, 719.3, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 50.0% + call wall  720", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
    if showLevels
        // per-row level lines + letter markers (table keys)
        line.new(bar_index - 40, 724.1, bar_index + 3, 724.1, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 724.1, "A★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 721.5, bar_index + 3, 721.5, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 721.5, "B★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 719.6, bar_index + 3, 719.6, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 719.6, "C★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 715.0, bar_index + 3, 715.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 715.0, "D★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 713.8, bar_index + 3, 713.8, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 713.8, "E★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 700.0, bar_index + 3, 700.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 700.0, "F", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
    if showGex
        // --- dealer-gamma (GEX) levels: labeled lines w/ price ---
        line.new(bar_index - 40, 720.0, bar_index + 3, 720.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 720.0, "Call wall 720", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 700.0, bar_index + 3, 700.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 700.0, "Put wall 700", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 722.0, bar_index + 3, 722.0, extend=extend.left, color=color.new((isDark ? #FDD835 : #B8860B), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 722.0, "Gamma flip 722", style=label.style_label_left, color=color.new((isDark ? #FDD835 : #B8860B), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 715.0, bar_index + 3, 715.0, extend=extend.left, color=color.new((isDark ? #AB47BC : #7B1FA2), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 715.0, "Max pain 715", style=label.style_label_left, color=color.new((isDark ? #AB47BC : #7B1FA2), 15), textcolor=color.white, size=size.small)
    // --- levels table ---
    if showTable
        // theme-aware table colors
        tblBg = isDark ? color.new(#0d1117, 4) : color.new(#f4f6f8, 3)
        tblTx = isDark ? color.new(#e6edf3, 0) : color.new(#1b2733, 0)
        tblHd = isDark ? color.new(#1f6feb, 0) : color.new(#0b4fa8, 0)
        var table pb = table.new(position.top_right, 4, 11, bgcolor=tblBg, border_width=1, border_color=color.new(color.gray, 60), frame_width=1)
        table.clear(pb, 0, 0, 3, 10)
        table.cell(pb, 0, 0, "QQQ 0DTE · 2026-07-15 · gamma negative · VIX 16", text_color=tblHd, text_size=size.normal, text_halign=text.align_left)
        table.merge_cells(pb, 0, 0, 3, 0)
        table.cell(pb, 0, 1, "Plan: below the 722 line = moves can run, expect momentum; buy dips near 719-720; sell rallies near 722", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 1, 3, 1)
        table.cell(pb, 0, 2, "A", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 2, "724", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 2, "resistance (4x tested) ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 2, "has held for 4 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 3, "B", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 3, "722", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 3, "✦ support (2x) + gamma flip ✦ ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 3, "good spot to sell rallies", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 4, "C", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 4, "720", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 4, "✦ fib 50.0% + call wall ✦ ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 4, "good spot to buy dips", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 5, "D", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 5, "715", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 5, "max pain ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 5, "price tends to drift back here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 6, "E", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 6, "714", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 6, "support (3x tested) ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 6, "has held for 4 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 7, "F", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 7, "700", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 7, "put wall", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 7, "price often stalls / turns here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 8, "Trend: no clear trend (choppy); stuck between 718 and 722 for now", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 8, 3, 8)
        table.cell(pb, 0, 9, "Volume: volume near its median — no clear tell", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 9, 3, 9)
        table.cell(pb, 0, 10, "★ = has held for many days · a guide, not a trade signal · not financial advice", text_color=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 10, 3, 10)
