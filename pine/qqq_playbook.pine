fadeSell5 = sellTrig5 and armedSell5
if fadeSell5
    tagSell5 := false
    nSell5 := 0
armedSell5 := confirmed ? (fadeSell5 ? false : (high < lvlSell5 * 0.999 ? true : armedSell5)) : armedSell5
plotshape(fadeSell5, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell5, title="durable resistance (4d)", message="QQQ lost durable resistance (4d) — reclaim-short confirmed.")
lvlSell6 = 715.3
var bool armedSell6 = true
var bool tagSell6 = false
var int nSell6 = 0
if confirmed
    if high >= lvlSell6
        tagSell6 := true
        nSell6 := close < lvlSell6 ? 1 : 0
    else
        nSell6 := tagSell6 ? nSell6 + 1 : 0
sellTrig6 = showArrows and confirmed and tagSell6 and nSell6 >= confirmCloses
fadeSell6 = sellTrig6 and armedSell6
if fadeSell6
    tagSell6 := false
    nSell6 := 0
armedSell6 := confirmed ? (fadeSell6 ? false : (high < lvlSell6 * 0.999 ? true : armedSell6)) : armedSell6
plotshape(fadeSell6, title="durable resistance (3d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell6, title="durable resistance (3d)", message="QQQ lost durable resistance (3d) — reclaim-short confirmed.")
lvlSell7 = 720.0
var bool armedSell7 = true
var bool tagSell7 = false
var int nSell7 = 0
if confirmed
    if high >= lvlSell7
        tagSell7 := true
        nSell7 := close < lvlSell7 ? 1 : 0
    else
        nSell7 := tagSell7 ? nSell7 + 1 : 0
sellTrig7 = showArrows and confirmed and tagSell7 and nSell7 >= confirmCloses
fadeSell7 = sellTrig7 and armedSell7
if fadeSell7
    tagSell7 := false
    nSell7 := 0
armedSell7 := confirmed ? (fadeSell7 ? false : (high < lvlSell7 * 0.999 ? true : armedSell7)) : armedSell7
plotshape(fadeSell7, title="durable resistance (3d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell7, title="durable resistance (3d)", message="QQQ lost durable resistance (3d) — reclaim-short confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="QQQ broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showZones
        box.new(bar_index - 40, 723.0, bar_index + 5, 722.3, border_color=color.new((isDark ? #EF5350 : #C62828), 55), bgcolor=color.new((isDark ? #EF5350 : #C62828), 88), extend=extend.left, text="support (2x) + gamma flip  723", text_size=size.small, text_color=(isDark ? #EF5350 : #C62828), text_halign=text.align_right, text_valign=text.align_top)
    if showLevels
        // per-row level lines + letter markers (table keys)
        line.new(bar_index - 40, 730.0, bar_index + 3, 730.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 730.0, "A", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 722.6, bar_index + 3, 722.6, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 45), width=1, style=line.style_solid)
        label.new(bar_index + 3, 722.6, "B", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 721.1, bar_index + 3, 721.1, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 721.1, "C★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 720.0, bar_index + 3, 720.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 720.0, "D★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 715.0, bar_index + 3, 715.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 715.0, "E★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 713.8, bar_index + 3, 713.8, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 713.8, "F★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 707.8, bar_index + 3, 707.8, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 707.8, "G★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 705.0, bar_index + 3, 705.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 705.0, "H★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 700.0, bar_index + 3, 700.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 700.0, "I", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
    if showGex
        // --- dealer-gamma (GEX) levels: labeled lines w/ price ---
        line.new(bar_index - 40, 730.0, bar_index + 3, 730.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 730.0, "Call wall 730", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 700.0, bar_index + 3, 700.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 700.0, "Put wall 700", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 723.0, bar_index + 3, 723.0, extend=extend.left, color=color.new((isDark ? #FDD835 : #B8860B), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 723.0, "Gamma flip 723", style=label.style_label_left, color=color.new((isDark ? #FDD835 : #B8860B), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 715.0, bar_index + 3, 715.0, extend=extend.left, color=color.new((isDark ? #AB47BC : #7B1FA2), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 715.0, "Max pain 715", style=label.style_label_left, color=color.new((isDark ? #AB47BC : #7B1FA2), 15), textcolor=color.white, size=size.small)
    // --- levels table ---
    if showTable
        // theme-aware table colors
        tblBg = isDark ? color.new(#0d1117, 4) : color.new(#f4f6f8, 3)
        tblTx = isDark ? color.new(#e6edf3, 0) : color.new(#1b2733, 0)
        tblHd = isDark ? color.new(#1f6feb, 0) : color.new(#0b4fa8, 0)
        var table pb = table.new(position.top_right, 4, 14, bgcolor=tblBg, border_width=1, border_color=color.new(color.gray, 60), frame_width=1)
        table.clear(pb, 0, 0, 3, 13)
        table.cell(pb, 0, 0, "QQQ 0DTE · 2026-07-15 · gamma negative · VIX 17", text_color=tblHd, text_size=size.normal, text_halign=text.align_left)
        table.merge_cells(pb, 0, 0, 3, 0)
        table.cell(pb, 0, 1, "Plan: below the 723 line = moves can run, expect momentum; support near 710; sell rallies near 723", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
