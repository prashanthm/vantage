plotshape(fadeSell8, title="durable resistance (7d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell8, title="durable resistance (7d)", message="SPX lost durable resistance (7d) — reclaim-short confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="SPX broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showZones
        box.new(bar_index - 40, 7550.0, bar_index + 5, 7544.0, border_color=color.new((isDark ? #EF5350 : #C62828), 55), bgcolor=color.new((isDark ? #EF5350 : #C62828), 88), extend=extend.left, text="gamma flip + round number  7547", text_size=size.small, text_color=(isDark ? #EF5350 : #C62828), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7530.5, bar_index + 5, 7520.6, border_color=color.new((isDark ? #EF5350 : #C62828), 55), bgcolor=color.new((isDark ? #EF5350 : #C62828), 88), extend=extend.left, text="resistance (5x) + call wall + fib 78.6%  7525", text_size=size.small, text_color=(isDark ? #EF5350 : #C62828), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7500.0, bar_index + 5, 7491.7, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 61.8% + volume PoC + round number  7496", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7474.0, bar_index + 5, 7464.4, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 50.0% + put wall  7469", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
    if showLevels
        // per-row level lines + letter markers (table keys)
        line.new(bar_index - 40, 7620.7, bar_index + 3, 7620.7, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 7620.7, "A★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 7600.4, bar_index + 3, 7600.4, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 7600.4, "B★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 7578.9, bar_index + 3, 7578.9, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 7578.9, "C★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 7547.0, bar_index + 3, 7547.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 45), width=1, style=line.style_solid)
        label.new(bar_index + 3, 7547.0, "D", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 7525.0, bar_index + 3, 7525.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 7525.0, "E★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 7496.2, bar_index + 3, 7496.2, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_solid)
        label.new(bar_index + 3, 7496.2, "F", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
