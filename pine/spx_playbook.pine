alertcondition(fadeBuy7, title="durable support (5d)", message="SPX reclaimed durable support (5d) — reclaim entry confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="SPX broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showZones
        box.new(bar_index - 40, 7560.2, bar_index + 5, 7550.0, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="round number + resistance (2x)  7555", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7520.6, bar_index + 5, 7518.8, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 78.6% + resistance (5x)  7520", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7500.0, bar_index + 5, 7491.0, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="gamma flip + volume PoC + max pain  7496", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
        box.new(bar_index - 40, 7480.0, bar_index + 5, 7470.8, border_color=color.new((isDark ? #26A69A : #1B7A70), 55), bgcolor=color.new((isDark ? #26A69A : #1B7A70), 88), extend=extend.left, text="fib 61.8% + support (4x)  7475", text_size=size.small, text_color=(isDark ? #26A69A : #1B7A70), text_halign=text.align_right, text_valign=text.align_top)
