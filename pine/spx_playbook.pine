//@version=5
indicator("SPX 0DTE Playbook — 2026-07-13", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// Generated by Vantage for the 2026-07-13 session (from 2026-07-12). Dealer gamma: positive.
// Confluence zones (≥2 dimensions stacking: GEX wall / gamma flip / fib / PoC / S-R) are
// baked from Python (Pine can't compute GEX/fib/PoC). The chart shows ONLY those zones + a
// corner table; the regime tint + arrows update live off price vs the gamma flip.
//
// ⚠️ NOT FINANCIAL ADVICE. Arrows are CONDITIONAL context (fade a confluence zone; go with
//    momentum on a flip break), not a guaranteed buy/sell. The GEX read is OI-based and BLIND
//    to 0DTE flow (~half of SPX volume). Context, not a signal (ADR-008). Apply on an SPX chart.

// ── theme (Auto uses the chart background; override with the input) ──
themeIn = input.string("Auto", "Theme", options=["Auto", "Dark", "Light"])
isDark = themeIn == "Dark" ? true : themeIn == "Light" ? false : (chart.bg_color == color.white ? false : true)
coexist = input.bool(false, "Coexist mode (with LuxAlgo etc.)", tooltip="On: suppress our shaded boxes so they don't collide with another indicator's zones — keep the table + letter lines only.")
showZones = input.bool(true, "Confluence zones (boxes)") and not coexist
showLevels = input.bool(true, "Level lines + letter keys")
showGex = input.bool(true, "Dealer-gamma (GEX) levels")
showTable = input.bool(true, "Levels table")
showArrows = input.bool(true, "Buy/Sell/Break arrows")
confirmCloses = input.int(3, "Reclaim confirmation closes", minval=1, maxval=5, tooltip="Consecutive closes back through a level required before an arrow fires — the validated reclaim discipline (3 consecutive 5m closes; set the chart to 5m to match). 1 = legacy single-bar behavior.")
showRegime = input.bool(true, "Regime tint") and not coexist

confirmed = barstate.isconfirmed
flipLevel = 7491.0
aboveFlip = close > flipLevel
bgcolor(showRegime and aboveFlip ? color.new(color.green, 96) : showRegime ? color.new(color.red, 96) : na)
lvlBuy1 = 7555.1
var bool armedBuy1 = true
var bool tagBuy1 = false
var int nBuy1 = 0
if confirmed
    if low <= lvlBuy1
        tagBuy1 := true
        nBuy1 := close > lvlBuy1 ? 1 : 0
    else
        nBuy1 := tagBuy1 ? nBuy1 + 1 : 0
buyTrig1 = showArrows and confirmed and tagBuy1 and nBuy1 >= confirmCloses
fadeBuy1 = buyTrig1 and armedBuy1
if fadeBuy1
    tagBuy1 := false
    nBuy1 := 0
armedBuy1 := confirmed ? (fadeBuy1 ? false : (low > lvlBuy1 * 1.001 ? true : armedBuy1)) : armedBuy1
plotshape(fadeBuy1, title="bounce support zone", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.small, text="BUY")
alertcondition(fadeBuy1, title="bounce support zone", message="SPX reclaimed bounce support zone — reclaim entry confirmed.")
lvlSell2 = 7620.7
var bool armedSell2 = true
var bool tagSell2 = false
var int nSell2 = 0
if confirmed
    if high >= lvlSell2
        tagSell2 := true
        nSell2 := close < lvlSell2 ? 1 : 0
    else
        nSell2 := tagSell2 ? nSell2 + 1 : 0
sellTrig2 = showArrows and confirmed and tagSell2 and nSell2 >= confirmCloses
fadeSell2 = sellTrig2 and armedSell2
if fadeSell2
    tagSell2 := false
    nSell2 := 0
armedSell2 := confirmed ? (fadeSell2 ? false : (high < lvlSell2 * 0.999 ? true : armedSell2)) : armedSell2
plotshape(fadeSell2, title="durable resistance (21d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell2, title="durable resistance (21d)", message="SPX lost durable resistance (21d) — reclaim-short confirmed.")
