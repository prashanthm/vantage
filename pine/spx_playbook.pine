        label.new(bar_index + 3, 7469.2, "G★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
    if showGex
        // --- dealer-gamma (GEX) levels: labeled lines w/ price ---
        line.new(bar_index - 40, 7524.0, bar_index + 3, 7524.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 7524.0, "Call wall 7524", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 7474.0, bar_index + 3, 7474.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 20), width=2, style=line.style_solid)
