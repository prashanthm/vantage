armedSell3 := confirmed ? (fadeSell3 ? false : (high < lvlSell3 * 0.999 ? true : armedSell3)) : armedSell3
plotshape(fadeSell3, title="durable resistance (21d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
