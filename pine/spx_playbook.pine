//@version=5
indicator("SPX 0DTE Playbook — 2026-07-14", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// Generated by Vantage for the 2026-07-14 session (from 2026-07-13). Dealer gamma: negative.
// Confluence zones (≥2 dimensions stacking: GEX wall / gamma flip / fib / PoC / S-R) are
// baked from Python (Pine can't compute GEX/fib/PoC). The chart shows ONLY those zones + a
// corner table; the regime tint + arrows update live off price vs the gamma flip.
//
// ⚠️ NOT FINANCIAL ADVICE. Arrows are CONDITIONAL context (fade a confluence zone; go with
//    momentum on a flip break), not a guaranteed buy/sell. The GEX read is OI-based and BLIND
//    to 0DTE flow. Context, not a signal (ADR-008). Apply on a SPX chart.

// ── theme (Auto uses the chart background; override with the input) ──
themeIn = input.string("Auto", "Theme", options=["Auto", "Dark", "Light"])
isDark = themeIn == "Dark" ? true : themeIn == "Light" ? false : (chart.bg_color == color.white ? false : true)
coexist = input.bool(false, "Coexist mode (with LuxAlgo etc.)", tooltip="On: suppress our shaded boxes so they don't collide with another indicator's zones — keep the table + letter lines only.")
showZones = input.bool(true, "Confluence zones (boxes)") and not coexist
showLevels = input.bool(true, "Level lines + letter keys")
showGex = input.bool(true, "Dealer-gamma (GEX) levels")
showTable = input.bool(true, "Levels table")
showArrows = input.bool(true, "Buy/Sell/Break arrows")
confirmCloses = input.int(3, "Reclaim confirmation closes", minval=1, maxval=5, tooltip="Consecutive closes back through a level required before an arrow fires — the validated reclaim discipline (3 consecutive 5m closes; set the chart to 5m to match). 1 = legacy single-bar behavior.")
showRegime = input.bool(true, "Regime tint") and not coexist

confirmed = barstate.isconfirmed
flipLevel = 7544.0
aboveFlip = close > flipLevel
bgcolor(showRegime and aboveFlip ? color.new(color.green, 96) : showRegime ? color.new(color.red, 96) : na)
lvlSell1 = 7547.0
var bool armedSell1 = true
var bool tagSell1 = false
var int nSell1 = 0
if confirmed
    if high >= lvlSell1
        tagSell1 := true
        nSell1 := close < lvlSell1 ? 1 : 0
    else
        nSell1 := tagSell1 ? nSell1 + 1 : 0
sellTrig1 = showArrows and confirmed and tagSell1 and nSell1 >= confirmCloses
fadeSell1 = sellTrig1 and armedSell1
if fadeSell1
    tagSell1 := false
    nSell1 := 0
armedSell1 := confirmed ? (fadeSell1 ? false : (high < lvlSell1 * 0.999 ? true : armedSell1)) : armedSell1
plotshape(fadeSell1, title="fade resistance zone", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.small, text="SELL")
alertcondition(fadeSell1, title="fade resistance zone", message="SPX lost fade resistance zone — reclaim-short confirmed.")
lvlBuy2 = 7496.2
var bool armedBuy2 = true
var bool tagBuy2 = false
var int nBuy2 = 0
if confirmed
    if low <= lvlBuy2
        tagBuy2 := true
        nBuy2 := close > lvlBuy2 ? 1 : 0
    else
        nBuy2 := tagBuy2 ? nBuy2 + 1 : 0
buyTrig2 = showArrows and confirmed and tagBuy2 and nBuy2 >= confirmCloses
fadeBuy2 = buyTrig2 and armedBuy2
if fadeBuy2
    tagBuy2 := false
    nBuy2 := 0
armedBuy2 := confirmed ? (fadeBuy2 ? false : (low > lvlBuy2 * 1.001 ? true : armedBuy2)) : armedBuy2
plotshape(fadeBuy2, title="bounce support zone", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.small, text="BUY")
alertcondition(fadeBuy2, title="bounce support zone", message="SPX reclaimed bounce support zone — reclaim entry confirmed.")
