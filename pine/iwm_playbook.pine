//@version=5
indicator("IWM 0DTE Playbook — 2026-07-15", overlay=true, max_boxes_count=200, max_lines_count=200, max_labels_count=200)

// Generated by Vantage for the 2026-07-15 session (from 2026-07-14). Dealer gamma: negative.
// Confluence zones (≥2 dimensions stacking: GEX wall / gamma flip / fib / PoC / S-R) are
// baked from Python (Pine can't compute GEX/fib/PoC). The chart shows ONLY those zones + a
// corner table; the regime tint + arrows update live off price vs the gamma flip.
//
// ⚠️ NOT FINANCIAL ADVICE. Arrows are CONDITIONAL context (fade a confluence zone; go with
//    momentum on a flip break), not a guaranteed buy/sell. The GEX read is OI-based and BLIND
//    to 0DTE flow. Context, not a signal (ADR-008). Apply on a IWM chart.

// ── theme (Auto uses the chart background; override with the input) ──
themeIn = input.string("Auto", "Theme", options=["Auto", "Dark", "Light"])
isDark = themeIn == "Dark" ? true : themeIn == "Light" ? false : (chart.bg_color == color.white ? false : true)
coexist = input.bool(false, "Coexist mode (with LuxAlgo etc.)", tooltip="On: suppress our shaded boxes so they don't collide with another indicator's zones — keep the table + letter lines only.")
showZones = input.bool(true, "Confluence zones (boxes)") and not coexist
showLevels = input.bool(true, "Level lines + letter keys")
showGex = input.bool(true, "Dealer-gamma (GEX) levels")
showTable = input.bool(true, "Levels table")
showArrows = input.bool(true, "Buy/Sell/Break arrows")
confirmCloses = input.int(3, "Reclaim confirmation closes", minval=1, maxval=5, tooltip="Consecutive closes back through a level required before an arrow fires — the validated reclaim discipline (3 consecutive 5m closes; set the chart to 5m to match). 1 = legacy single-bar behavior.")
showRegime = input.bool(true, "Regime tint") and not coexist

confirmed = barstate.isconfirmed
flipLevel = 299.0
aboveFlip = close > flipLevel
bgcolor(showRegime and aboveFlip ? color.new(color.green, 96) : showRegime ? color.new(color.red, 96) : na)
lvlSell1 = 295.0
var bool armedSell1 = true
var bool tagSell1 = false
var int nSell1 = 0
if confirmed
    if high >= lvlSell1
        tagSell1 := true
        nSell1 := close < lvlSell1 ? 1 : 0
    else
        nSell1 := tagSell1 ? nSell1 + 1 : 0
sellTrig1 = showArrows and confirmed and tagSell1 and nSell1 >= confirmCloses
fadeSell1 = sellTrig1 and armedSell1
if fadeSell1
    tagSell1 := false
    nSell1 := 0
armedSell1 := confirmed ? (fadeSell1 ? false : (high < lvlSell1 * 0.999 ? true : armedSell1)) : armedSell1
plotshape(fadeSell1, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell1, title="durable resistance (4d)", message="IWM lost durable resistance (4d) — reclaim-short confirmed.")
lvlSell2 = 296.6
var bool armedSell2 = true
var bool tagSell2 = false
var int nSell2 = 0
if confirmed
    if high >= lvlSell2
        tagSell2 := true
        nSell2 := close < lvlSell2 ? 1 : 0
    else
        nSell2 := tagSell2 ? nSell2 + 1 : 0
sellTrig2 = showArrows and confirmed and tagSell2 and nSell2 >= confirmCloses
fadeSell2 = sellTrig2 and armedSell2
if fadeSell2
    tagSell2 := false
    nSell2 := 0
armedSell2 := confirmed ? (fadeSell2 ? false : (high < lvlSell2 * 0.999 ? true : armedSell2)) : armedSell2
plotshape(fadeSell2, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell2, title="durable resistance (4d)", message="IWM lost durable resistance (4d) — reclaim-short confirmed.")
lvlSell3 = 297.6
var bool armedSell3 = true
var bool tagSell3 = false
var int nSell3 = 0
if confirmed
    if high >= lvlSell3
        tagSell3 := true
        nSell3 := close < lvlSell3 ? 1 : 0
    else
        nSell3 := tagSell3 ? nSell3 + 1 : 0
sellTrig3 = showArrows and confirmed and tagSell3 and nSell3 >= confirmCloses
fadeSell3 = sellTrig3 and armedSell3
if fadeSell3
    tagSell3 := false
    nSell3 := 0
armedSell3 := confirmed ? (fadeSell3 ? false : (high < lvlSell3 * 0.999 ? true : armedSell3)) : armedSell3
plotshape(fadeSell3, title="durable resistance (4d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell3, title="durable resistance (4d)", message="IWM lost durable resistance (4d) — reclaim-short confirmed.")
lvlBuy4 = 290.7
var bool armedBuy4 = true
var bool tagBuy4 = false
var int nBuy4 = 0
if confirmed
    if low <= lvlBuy4
        tagBuy4 := true
        nBuy4 := close > lvlBuy4 ? 1 : 0
    else
        nBuy4 := tagBuy4 ? nBuy4 + 1 : 0
buyTrig4 = showArrows and confirmed and tagBuy4 and nBuy4 >= confirmCloses
fadeBuy4 = buyTrig4 and armedBuy4
if fadeBuy4
    tagBuy4 := false
    nBuy4 := 0
armedBuy4 := confirmed ? (fadeBuy4 ? false : (low > lvlBuy4 * 1.001 ? true : armedBuy4)) : armedBuy4
plotshape(fadeBuy4, title="durable support (4d)", location=location.belowbar, style=shape.triangleup, color=(isDark ? #26A69A : #1B7A70), size=size.normal, text="BUY★")
alertcondition(fadeBuy4, title="durable support (4d)", message="IWM reclaimed durable support (4d) — reclaim entry confirmed.")
lvlSell5 = 296.1
var bool armedSell5 = true
var bool tagSell5 = false
var int nSell5 = 0
if confirmed
    if high >= lvlSell5
        tagSell5 := true
        nSell5 := close < lvlSell5 ? 1 : 0
    else
        nSell5 := tagSell5 ? nSell5 + 1 : 0
sellTrig5 = showArrows and confirmed and tagSell5 and nSell5 >= confirmCloses
fadeSell5 = sellTrig5 and armedSell5
if fadeSell5
    tagSell5 := false
    nSell5 := 0
armedSell5 := confirmed ? (fadeSell5 ? false : (high < lvlSell5 * 0.999 ? true : armedSell5)) : armedSell5
plotshape(fadeSell5, title="durable resistance (3d)", location=location.abovebar, style=shape.triangledown, color=(isDark ? #EF5350 : #C62828), size=size.normal, text="SELL★")
alertcondition(fadeSell5, title="durable resistance (3d)", message="IWM lost durable resistance (3d) — reclaim-short confirmed.")
var bool wasAbove = true
momoBreak = showArrows and confirmed and close < flipLevel and wasAbove
wasAbove := confirmed ? close > flipLevel : wasAbove
plotshape(momoBreak, title="flip break (momentum)", location=location.abovebar, style=shape.xcross, color=(isDark ? #FFB300 : #B8860B), size=size.tiny, text="BREAK")
alertcondition(momoBreak, title="Gamma flip break", message="IWM broke below the gamma flip — momentum regime.")

if barstate.islastconfirmedhistory
    // --- confluence zones (shaded boxes where ≥2 dims stack) ---
    if showLevels
        // per-row level lines + letter markers (table keys)
        line.new(bar_index - 40, 299.0, bar_index + 3, 299.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 299.0, "A", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 297.6, bar_index + 3, 297.6, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 297.6, "B★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 296.6, bar_index + 3, 296.6, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 296.6, "C★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 296.1, bar_index + 3, 296.1, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 296.1, "D★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 295.0, bar_index + 3, 295.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 295.0, "E★", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 294.4, bar_index + 3, 294.4, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 294.4, "F★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 290.7, bar_index + 3, 290.7, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 35), width=2, style=line.style_solid)
        label.new(bar_index + 3, 290.7, "G★", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
        line.new(bar_index - 40, 290.0, bar_index + 3, 290.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 45), width=1, style=line.style_dotted)
        label.new(bar_index + 3, 290.0, "H", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 0), textcolor=color.white, size=size.normal)
    if showGex
        // --- dealer-gamma (GEX) levels: labeled lines w/ price ---
        line.new(bar_index - 40, 295.0, bar_index + 3, 295.0, extend=extend.left, color=color.new((isDark ? #EF5350 : #C62828), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 295.0, "Call wall 295", style=label.style_label_left, color=color.new((isDark ? #EF5350 : #C62828), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 290.0, bar_index + 3, 290.0, extend=extend.left, color=color.new((isDark ? #26A69A : #1B7A70), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 290.0, "Put wall 290", style=label.style_label_left, color=color.new((isDark ? #26A69A : #1B7A70), 15), textcolor=color.white, size=size.small)
        line.new(bar_index - 40, 299.0, bar_index + 3, 299.0, extend=extend.left, color=color.new((isDark ? #FDD835 : #B8860B), 20), width=2, style=line.style_solid)
        label.new(bar_index + 40, 299.0, "Gamma flip 299", style=label.style_label_left, color=color.new((isDark ? #FDD835 : #B8860B), 15), textcolor=color.white, size=size.small)
    // --- levels table ---
    if showTable
        // theme-aware table colors
        tblBg = isDark ? color.new(#0d1117, 4) : color.new(#f4f6f8, 3)
        tblTx = isDark ? color.new(#e6edf3, 0) : color.new(#1b2733, 0)
        tblHd = isDark ? color.new(#1f6feb, 0) : color.new(#0b4fa8, 0)
        var table pb = table.new(position.top_right, 4, 13, bgcolor=tblBg, border_width=1, border_color=color.new(color.gray, 60), frame_width=1)
        table.clear(pb, 0, 0, 3, 12)
        table.cell(pb, 0, 0, "IWM 0DTE · 2026-07-15 · gamma negative · VIX 16", text_color=tblHd, text_size=size.normal, text_halign=text.align_left)
        table.merge_cells(pb, 0, 0, 3, 0)
        table.cell(pb, 0, 1, "Plan: below the 299 line = moves can run, expect momentum; support near 294; sell rallies near 295", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 1, 3, 1)
        table.cell(pb, 0, 2, "A", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 2, "299", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 2, "gamma flip", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 2, "trend-change line: above = calmer, below = faster moves", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 3, "B", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 3, "298", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 3, "resistance (3x tested) ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 3, "has held for 4 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 4, "C", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 4, "297", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 4, "resistance (2x tested) ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 4, "has held for 4 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 5, "D", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 5, "296", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 5, "durable resistance ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 5, "has held for 3 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 6, "E", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 6, "295", text_color=(isDark ? #EF5350 : #C62828), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 6, "call wall ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 6, "price often stalls / turns here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 7, "F", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 7, "294", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 7, "volume PoC ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 7, "price gets stuck / chops here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 8, "G", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 8, "291", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 8, "durable support ★4d", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 8, "has held for 4 days — watch it closely", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 9, "H", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_center)
        table.cell(pb, 1, 9, "290", text_color=(isDark ? #26A69A : #1B7A70), text_size=size.normal, text_halign=text.align_right)
        table.cell(pb, 2, 9, "put wall", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 3, 9, "price often stalls / turns here", text_color=tblTx, text_size=size.normal, text_halign=text.align_left)
        table.cell(pb, 0, 10, "Trend: no clear trend (choppy); stuck between 294 and 295 for now", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 10, 3, 10)
        table.cell(pb, 0, 11, "Volume: expanding on the push — buyers confirming", text_color=tblTx, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 11, 3, 11)
        table.cell(pb, 0, 12, "★ = has held for many days · a guide, not a trade signal · not financial advice", text_color=color.new(color.gray, 20), text_size=size.small, text_halign=text.align_left)
        table.merge_cells(pb, 0, 12, 3, 12)
