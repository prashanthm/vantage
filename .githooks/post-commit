#!/usr/bin/env bash
# Auto-refresh the CodeGraph index after a commit so the local symbol/call graph
# (.codegraph/) never drifts from the code. Incremental (`sync` = only changes since
# last index), backgrounded so it never slows the commit, and a no-op if codegraph
# isn't installed. See tools/codegraph-eval.md / AGENTS.md.
command -v codegraph >/dev/null 2>&1 || exit 0
( codegraph sync >/dev/null 2>&1 & )
exit 0
