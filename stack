#!/usr/bin/env bash
# Vantage stack control — sentinel-style start/stop for the whole stack.
#
#   ./stack setup            one-time: venvs for server/ + mcp/ (+ checks mira)
#   ./stack start [--live]   start api (:8641) + mcp (:8640) + spa (:8642) + mira (:8080)
#   ./stack stop             stop everything listening on the stack ports
#   ./stack status           pids + health of all four services
#   ./stack logs [name]      tail logs (api|mcp|spa|mira; default all)
#
# --live uses the delayed Stooq quote feed instead of fixture quotes.
# MIRA_DIR overrides where Mira lives (default ~/personal/mira); if missing,
# the stack runs without AI (the SPA degrades to canned chat by design).
set -euo pipefail
cd "$(dirname "$0")"

LOG_DIR=logs
MIRA_DIR="${MIRA_DIR:-$HOME/personal/mira}"
API_PORT=8641 MCP_PORT=8640 SPA_PORT=8642 MIRA_PORT=8080
mkdir -p "$LOG_DIR"

port_of() {  # port_of <name>
  case "$1" in
    api) echo "$API_PORT" ;; mcp) echo "$MCP_PORT" ;;
    spa) echo "$SPA_PORT" ;; mira) echo "$MIRA_PORT" ;;
  esac
}

pid_on() {  # pid_on <port> -> first pid listening, or empty
  { lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null || true; } | head -1
}

start_one() {  # start_one <name> <workdir> <cmd...>
  local name=$1 dir=$2; shift 2
  local port; port=$(port_of "$name")
  if [ -n "$(pid_on "$port")" ]; then
    echo "  $name: already running (pid $(pid_on "$port") on :$port)"
    return
  fi
  ( cd "$dir" && exec "$@" >> "$OLDPWD/$LOG_DIR/$name.log" 2>&1 ) &
  sleep 0.3
  echo "  $name: starting on :$port"
}

stop_one() {
  local name=$1 port pids
  port=$(port_of "$name")
  pids=$(lsof -ti "tcp:$port" -sTCP:LISTEN 2>/dev/null || true)
  if [ -n "$pids" ]; then
    echo "$pids" | xargs kill 2>/dev/null || true
    echo "  $name: stopped (:$port)"
  else
    echo "  $name: not running"
  fi
}

probe() { curl -sf --max-time 2 "$1" > /dev/null 2>&1 && echo ok || echo down; }

cmd_setup() {
  echo "== server (engine + REST)"; make -C server setup
  echo "== mcp (AI tool surface)";  make -C mcp setup
  if [ -x "$MIRA_DIR/.venv/bin/python" ]; then
    echo "== mira: found at $MIRA_DIR"
  else
    echo "== mira: NOT set up at $MIRA_DIR (run 'make setup' there, or set MIRA_DIR)"
  fi
  echo "Done. ./stack start"
}

cmd_start() {
  # Real market data (yfinance) is the default. --demo opts into the
  # deterministic fixture seam (synthetic data only; not a shipped dataset).
  local quotes="yfinance"
  [ "${1:-}" = "--demo" ] && quotes="fixture"
  echo "starting vantage stack (quotes: $quotes)..."
  start_one api  server env VANTAGE_QUOTES="$quotes" .venv/bin/python -m uvicorn vantage_server.api:app --host 127.0.0.1 --port "$API_PORT"
  start_one mcp  mcp    env VANTAGE_QUOTES="$quotes" .venv/bin/python -m vantage_mcp.server
  start_one spa  .      python3 -m http.server "$SPA_PORT" --bind 127.0.0.1
  if [ -x "$MIRA_DIR/.venv/bin/python" ]; then
    start_one mira "$MIRA_DIR" env MCP_BASE_URL="http://127.0.0.1:$MCP_PORT/mcp" "$MIRA_DIR/.venv/bin/python" -m mira --port "$MIRA_PORT"
  else
    echo "  mira: skipped (not found at $MIRA_DIR — SPA falls back to canned chat)"
  fi
  sleep 3
  cmd_status
  echo ""
  echo "open http://localhost:$SPA_PORT"
}

cmd_stop() {
  echo "stopping vantage stack..."
  for name in mira spa mcp api; do stop_one "$name"; done
}

cmd_status() {
  local pid
  printf "  %-5s %-8s %-6s %s\n" NAME PID HEALTH URL
  pid=$(pid_on "$API_PORT");  printf "  %-5s %-8s %-6s %s\n" api  "${pid:--}" "$(probe "http://127.0.0.1:$API_PORT/api/health")" "http://127.0.0.1:$API_PORT/api/*"
  pid=$(pid_on "$MCP_PORT");  printf "  %-5s %-8s %-6s %s\n" mcp  "${pid:--}" "$([ -n "$pid" ] && echo ok || echo down)" "http://127.0.0.1:$MCP_PORT/mcp"
  pid=$(pid_on "$SPA_PORT");  printf "  %-5s %-8s %-6s %s\n" spa  "${pid:--}" "$(probe "http://127.0.0.1:$SPA_PORT/")" "http://localhost:$SPA_PORT"
  pid=$(pid_on "$MIRA_PORT"); printf "  %-5s %-8s %-6s %s\n" mira "${pid:--}" "$(probe "http://127.0.0.1:$MIRA_PORT/health")" "http://127.0.0.1:$MIRA_PORT/turn"
}

cmd_logs() {
  local which=${1:-}
  if [ -n "$which" ]; then tail -f "$LOG_DIR/$which.log"; else tail -f "$LOG_DIR"/*.log; fi
}

# --- nightly EOD pipeline schedule (launchd) ---------------------------------
CRON_LABEL="com.pmuniraju.vantage.nightly"
CRON_PLIST="$HOME/Library/LaunchAgents/$CRON_LABEL.plist"

cmd_cron_install() {
  local repo; repo="$(pwd)"
  cat > "$CRON_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$CRON_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$repo/nightly.sh</string></array>
  <key>WorkingDirectory</key><string>$repo</string>
  <key>EnvironmentVariables</key>
  <dict><key>TZ</key><string>America/New_York</string><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>1</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>2</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>4</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>$repo/$LOG_DIR/nightly.log</string>
  <key>StandardErrorPath</key><string>$repo/$LOG_DIR/nightly.log</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$CRON_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$CRON_PLIST"
  echo "installed $CRON_LABEL — weeknights 17:45 ET → nightly.sh (bars + analyze). Logs: $LOG_DIR/nightly.log"
}

cmd_cron_uninstall() {
  launchctl bootout "gui/$(id -u)/$CRON_LABEL" 2>/dev/null || true
  rm -f "$CRON_PLIST"
  echo "uninstalled $CRON_LABEL"
}

# --- nightly EOD schedule for the DOCKER stack (runs inside the container) ----
# The host nightly writes server/data-local/; the Compose stack reads the
# vantage-data volume at /data. This schedule invokes nightly-docker.sh, which
# docker-execs the pipeline into the backend container so it lands in the DB the
# UI reads. launchd runs with a bare PATH, so we set one that finds `docker`.
CRON_LABEL_DOCKER="com.pmuniraju.vantage.nightly.docker"
CRON_PLIST_DOCKER="$HOME/Library/LaunchAgents/$CRON_LABEL_DOCKER.plist"

cmd_cron_install_docker() {
  local repo; repo="$(pwd)"
  cat > "$CRON_PLIST_DOCKER" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$CRON_LABEL_DOCKER</string>
  <key>ProgramArguments</key>
  <array><string>$repo/nightly-docker.sh</string></array>
  <key>WorkingDirectory</key><string>$repo</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key><string>America/New_York</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>1</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>2</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>3</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>4</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>$repo/$LOG_DIR/nightly.log</string>
  <key>StandardErrorPath</key><string>$repo/$LOG_DIR/nightly.log</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$(id -u)/$CRON_LABEL_DOCKER" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$CRON_PLIST_DOCKER"
  echo "installed $CRON_LABEL_DOCKER — weeknights 17:45 ET → nightly-docker.sh (bars + analyze in the backend container). Logs: $LOG_DIR/nightly.log"
}

cmd_cron_uninstall_docker() {
  launchctl bootout "gui/$(id -u)/$CRON_LABEL_DOCKER" 2>/dev/null || true
  rm -f "$CRON_PLIST_DOCKER"
  echo "uninstalled $CRON_LABEL_DOCKER"
}

case "${1:-}" in
  setup)  cmd_setup ;;
  start)  shift; cmd_start "${1:-}" ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  logs)   shift; cmd_logs "${1:-}" ;;
  nightly) shift; ./nightly.sh "${1:-}" ;;
  nightly-docker) shift; ./nightly-docker.sh "${1:-}" ;;
  cron-install)   cmd_cron_install ;;
  cron-uninstall) cmd_cron_uninstall ;;
  cron-install-docker)   cmd_cron_install_docker ;;
  cron-uninstall-docker) cmd_cron_uninstall_docker ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
