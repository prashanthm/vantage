<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pmuniraju.vantage.scanner</string>
  <key>ProgramArguments</key>
  <array><string>/Users/pmuniraju/personal/vantage/scanner-cron.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/pmuniraju/personal/vantage</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key><string>America/New_York</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- hourly; the script self-gates to RTH (Mon-Fri 09:30-16:00 ET) -->
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>/Users/pmuniraju/personal/vantage/logs/scanner-cron.log</string>
  <key>StandardErrorPath</key><string>/Users/pmuniraju/personal/vantage/logs/scanner-cron.log</string>
</dict>
</plist>
