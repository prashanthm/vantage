# Copy to `.env` (same dir as docker-compose.yml) and edit.
# docker compose auto-loads deploy/.env when run with -f deploy/docker-compose.yml
# FROM the deploy/ directory, or pass --env-file deploy/.env explicitly.

# --- Robinhood token (required for POST /api/refresh and /api/ticket/execute) --
# Host DIRECTORY containing .robinhood_token.json (chmod 600). Mounted
# READ-WRITE at /run/secrets/robinhood: Vantage owns the grant now (inherited
# from the retired sentinel — pointing at the sentinel checkout is fine) and
# token refresh must write the rotated refresh token back. Leave unset to run
# read-only.
#ROBINHOOD_TOKEN_DIR=/absolute/path/to/sentinel

# --- Live trading gate (ADR-010 v2) ------------------------------------------
# POST /api/ticket/execute is DRY-RUN unless BOTH the request sets live:true
# AND this is exactly 1. Leave unset for staged/dry-run behavior everywhere.
#VANTAGE_LIVE_OK=1

# --- Alpaca strategy lifecycle (ADR-015) -------------------------------------
# Read + paper/live orders for the strategy lifecycle. Paper keys work against
# the paper endpoint; you can reuse the retired sentinel's Alpaca keys.
#ALPACA_API_KEY=your-alpaca-key
#ALPACA_SECRET_KEY=your-alpaca-secret
# Paper endpoint by default; set to 0 ONLY for the live cash/margin account.
#ALPACA_PAPER=1
# AUTONOMOUS live entry (ADR-015) is DOUBLE-gated: a strategy submits real orders
# only when live:true AND VANTAGE_LIVE_OK=1 AND this is exactly 1 AND the kill
# switch file is absent. This is DISTINCT from the reclaim path's gate — enabling
# one never enables the other. Leave unset: strategies run paper/dry-run only.
#VANTAGE_AUTONOMOUS_OK=1
# Kill switch: create this file to instantly halt every autonomous submit.
#VANTAGE_KILL_SWITCH_FILE=/run/vantage/AUTONOMOUS_KILL

# --- Reclaim signal bot → Telegram --------------------------------------------
# Create a bot with @BotFather, put its token here; chat id = your DM or group.
# Unset = the bot still arms/tracks paper trades but only logs what it'd send.
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789

# --- Coach alerts → TradingView webhook → Telegram ----------------------------
# Shared secret the coach's TradingView alerts must carry (baked into the Pine,
# validated by /webhook/tradingview). Can also be set from the API. Any random
# string. Never commit the real value.
#COACH_WEBHOOK_SECRET=change-me-to-a-random-string
# Pick ONE tunnel to expose just the webhook path (see deploy/README-webhook.md).
# ngrok (--profile webhook-ngrok): your authtoken + reserved static domain.
#NGROK_AUTHTOKEN=your-ngrok-authtoken
#NGROK_DOMAIN=unrived-unconventional-bethanie.ngrok-free.dev
# OR Cloudflare Tunnel (--profile webhook-cf): the tunnel token.
#CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# --- Quotes ------------------------------------------------------------------
# `yfinance` = live delayed quotes (default). `fixture` = deterministic demo quotes.
VANTAGE_QUOTES=yfinance
# Quote snapshot cache TTL in seconds (code default when unset).
#VANTAGE_QUOTES_TTL=300

# --- Claude forecast analyst (POST /api/spx/forecast/claude) --------------------
# The AI forecast ("what will price do?") is generated by Claude via the
# Anthropic API — the backend builds the enriched prompt (snapshot inlined +
# discipline rules) and streams the reply; the key never reaches the browser.
# Unset = the endpoint answers 503 and the SPA falls back to Mira.
#ANTHROPIC_API_KEY=sk-ant-...
# Model override (default: claude-opus-5).
#VANTAGE_CLAUDE_MODEL=claude-opus-5

# --- Mira LLM / agent config ----------------------------------------------------
# NOT here anymore. Mira runs from its OWN stack (mira/deploy/) with its own
# .env / .env.local — that is where LLM_BASE_URL / LLM_MODEL / LLM_API_KEY /
# MODEL_ROUTES live now. Vantage only publishes vantage-mcp on host :8640; Mira
# reaches it from its stack via host.docker.internal:8640. (Keeping these vars
# here is what let the model config silently revert to Ollama on 2026-07-13.)

# --- Zerodha (Kite Connect) — optional, for an INR Indian-equity account -------
# From your Kite Connect app at developer.kite.trade. The key/secret enter the
# backend env here (never the browser); the daily access token is generated by
# the host-side one-time auth and mounted read-only (KITE_TOKEN_FILE).
#KITE_API_KEY=82guqdye9gwiruzs
#KITE_API_SECRET=zpww82o1yn7yzw55nu181ys7ycsrcxdm
# KITE_TOKEN_FILE is only for the HOST-CLI auth path (--broker zerodha --auth).
# The CONTAINER uses /data/.kite_token.json (writable volume) automatically, so
# the one-click Re-authenticate button in the UI needs nothing here.
#KITE_TOKEN_FILE=/Users/you/vantage/server/.kite_token.json

# --- Sentinel intel (optional; playbook reads a thinner scaffold without it) ----
#SENTINEL_LOGS_DIR=/absolute/path/to/sentinel/logs
#SENTINEL_DATA_DIR=/absolute/path/to/sentinel/data

# --- Nightly ML build (nightly-docker.sh) ---------------------------------------
# Vantage account id + broker-side account number for the round-trips build.
# ML_BROKER_ACCOUNT auto-resolves from imported history when unset.
#ML_ACCOUNT=rh-margin
#ML_BROKER_ACCOUNT=
