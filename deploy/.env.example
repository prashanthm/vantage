# Copy to `.env` (same dir as docker-compose.yml) and edit.
# docker compose auto-loads deploy/.env when run with -f deploy/docker-compose.yml
# FROM the deploy/ directory, or pass --env-file deploy/.env explicitly.

# --- Robinhood token (required ONLY for POST /api/refresh; reads work without) --
# Host path to the Robinhood OAuth token JSON (chmod 600). Mounted read-only into
# the backend at /run/secrets/robinhood_token.json. Leave unset to run read-only.
#ROBINHOOD_TOKEN_FILE=/absolute/path/to/.robinhood_token.json

# --- Quotes ------------------------------------------------------------------
# `yfinance` = live delayed quotes (default). `fixture` = deterministic demo quotes.
VANTAGE_QUOTES=yfinance
# Quote snapshot cache TTL in seconds (code default when unset).
#VANTAGE_QUOTES_TTL=300

# --- Mira LLM (host Ollama by default) ---------------------------------------
# OpenAI-compatible endpoint. host.docker.internal reaches the host from a
# container. Point at any /v1 endpoint (Ollama / vLLM direct, DeepSeek, Bedrock
# via proxy).
LLM_BASE_URL=http://host.docker.internal:11434/v1
# MUST be a tag the endpoint actually serves — for Ollama check `ollama list`;
# a bare "qwen2.5" (no tag) 404s and the advisor returns empty.
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# --- Model-tier routing (ADR-052) ---------------------------------------------
# Maps capability tiers to concrete models on LLM_BASE_URL. /analyze synthesis
# and the pre-mortem ride `deep`; facets/playbook narration ride `light`.
# Unset = no router (everything on LLM_MODEL).
MODEL_ROUTES=[{"provider":"ollama","model":"qwen2.5:7b","tier":"light","cost_per_1k_tokens":0.0},{"provider":"ollama","model":"qwen2.5:14b","tier":"deep","cost_per_1k_tokens":0.0}]
ENABLE_TIER_ESCALATION=1
# DeepSeek instead of Ollama: LLM_BASE_URL=https://api.deepseek.com/v1,
# LLM_MODEL=deepseek-chat, LLM_API_KEY=<your key>, and
# MODEL_ROUTES=[{"provider":"deepseek","model":"deepseek-chat","tier":"light","cost_per_1k_tokens":0.00028},{"provider":"deepseek","model":"deepseek-reasoner","tier":"deep","cost_per_1k_tokens":0.0022}]

# --- Mira composition -----------------------------------------------------------
# `local` = in-memory providers, no cloud SDK — the right shape for this stack.
DEPLOYMENT_PROFILE=local
PLATFORM=local
# Vantage MCP over the compose network (container DNS name), NOT localhost.
#MCP_BASE_URL=http://vantage-mcp:8640/mcp

# --- Sentinel intel (optional; playbook reads a thinner scaffold without it) ----
#SENTINEL_LOGS_DIR=/absolute/path/to/sentinel/logs
#SENTINEL_DATA_DIR=/absolute/path/to/sentinel/data

# --- Nightly ML build (nightly-docker.sh) ---------------------------------------
# Vantage account id + broker-side account number for the round-trips build.
# ML_BROKER_ACCOUNT auto-resolves from imported history when unset.
#ML_ACCOUNT=rh-margin
#ML_BROKER_ACCOUNT=
